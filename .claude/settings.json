{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "context-mode@context-mode": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash", "WebFetch", "WebSearch"],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(./**/*secret*)",
      "Read(./**/.env*)"
    ]
  }
}
