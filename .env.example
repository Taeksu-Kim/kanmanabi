POSTGRES_USER=korean
POSTGRES_PASSWORD=change-me
POSTGRES_DB=korean_helper
DATABASE_URL=postgresql+psycopg://korean:change-me@db:5432/korean_helper

# --- 인증 ---
# Google OAuth 웹 클라이언트 ID(공개값). 없으면 /api/auth/google 이 501.
GOOGLE_CLIENT_ID=
# 세션 쿠키 서명 키. 운영은 반드시 새 랜덤값(바뀌면 전체 로그아웃).
#   생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-prod
# false면 쿠키 없는 요청이 dev 스텁 유저로 폴백한다. 운영은 반드시 true.
AUTH_REQUIRED=false
# https 배포에서 true. 로컬 http는 false(Secure 쿠키가 전송되지 않는다).
COOKIE_SECURE=false
# 로그인 요청을 허용할 Origin(쉼표 구분). 비면 검사하지 않는다.
# 운영 예: https://xxxx.cloudfront.net
ALLOWED_ORIGINS=
